# Copy to .env for local use: make env
# Placeholders only. Replace every value before any non-dev deployment.
APP_ENV=dev
APP_NAME=Slotwise
APP_VERSION=0.1.0
APP_LOG_LEVEL=INFO
APP_DEBUG=false
APP_DOCS_ENABLED=true
APP_ALLOWED_HOSTS=localhost,127.0.0.1,testserver,api,nginx
APP_CORS_ORIGINS=http://localhost:5173,https://localhost

# Keep the password URL-safe (letters, digits, '-', '_'); DATABASE_URL is built in Compose.
POSTGRES_USER=slotwise
POSTGRES_PASSWORD=slotwise-dev-password
POSTGRES_DB=slotwise

REDIS_URL=redis://redis:6379/0
REDIS_QUEUE_NAMES=celery
REDIS_QUEUE_DEPTH_REFRESH_SECONDS=15

OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_VERIFY_CERTS=false

MINIO_ROOT_USER=slotwise
MINIO_ROOT_PASSWORD=slotwise-dev-minio-password
MINIO_BUCKET=slotwise-artifacts
MINIO_MLFLOW_BUCKET=slotwise-mlflow
# Backend S3 credentials. Compose derives these from MINIO_ROOT_*; set them
# explicitly only for bare-metal runs and keep them in sync.
MINIO_ACCESS_KEY=slotwise
MINIO_SECRET_KEY=slotwise-dev-minio-password

MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=slotwise

# Development sentinel. Rejected automatically when APP_ENV is staging or prod.
SECURITY_SECRET_KEY=dev-only-insecure-secret-key-change-me
SECURITY_ACCESS_TOKEN_EXPIRE_MINUTES=15

MODULE_B_ENABLED=false
ALLOW_SELF_APPROVAL=false

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana
