# Copy to .env for local use: make env
# Placeholders only. Replace every value before any non-dev deployment.
APP_ENV=dev
APP_NAME=Slotwise
APP_VERSION=0.1.0
APP_LOG_LEVEL=INFO
APP_DEBUG=false
APP_DOCS_ENABLED=true
APP_ALLOWED_HOSTS=localhost,127.0.0.1,testserver,api,nginx
APP_CORS_ORIGINS=http://localhost:5173,https://localhost

# Keep the password URL-safe (letters, digits, '-', '_'); DATABASE_URL is built in Compose.
POSTGRES_USER=slotwise
POSTGRES_PASSWORD=slotwise-dev-password
POSTGRES_DB=slotwise

# Least-privilege database roles. The application role has no DDL rights; the
# migration role owns the schema and is used only by Alembic.
APP_DB_USER=slotwise_app
APP_DB_PASSWORD=slotwise-app-dev-password
MIGRATION_DB_USER=slotwise_migrator
MIGRATION_DB_PASSWORD=slotwise-migrator-dev-password
DATABASE_APP_ROLE=slotwise_app
DATABASE_MIGRATION_ROLE=slotwise_migrator
DATABASE_APPLICATION_NAME=slotwise-api
DATABASE_STATEMENT_TIMEOUT_MS=15000

# Bare-metal local runs only (`make -C backend migrate`, `make seed-local`).
# Compose injects service-qualified URLs and ignores these two values.
DATABASE_URL=postgresql+asyncpg://slotwise_app:slotwise-app-dev-password@localhost:5432/slotwise
DATABASE_MIGRATION_URL=postgresql+asyncpg://slotwise_migrator:slotwise-migrator-dev-password@localhost:5432/slotwise

# Bootstrap account for `make seed`. The password is refused when weak or a
# placeholder outside dev/test. Change it before any shared deployment.
SEED_ADMIN_EMAIL=admin@slotwise.local
SEED_ADMIN_PASSWORD=Slotwise-Dev-Admin-2026!
SEED_DEMO=false
# Demo principals are only created by `make seed-demo` and only in dev/test.
# Leave these unset in any shared environment.
SEED_ANALYST_EMAIL=analyst@slotwise.local
SEED_ANALYST_PASSWORD=
SEED_VIEWER_EMAIL=viewer@slotwise.local
SEED_VIEWER_PASSWORD=

REDIS_URL=redis://redis:6379/0
REDIS_QUEUE_NAMES=celery
REDIS_QUEUE_DEPTH_REFRESH_SECONDS=15

OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_VERIFY_CERTS=false

MINIO_ROOT_USER=slotwise
MINIO_ROOT_PASSWORD=slotwise-dev-minio-password
MINIO_BUCKET=slotwise-artifacts
MINIO_MLFLOW_BUCKET=slotwise-mlflow
# Backend S3 credentials. Compose derives these from MINIO_ROOT_*; set them
# explicitly only for bare-metal runs and keep them in sync.
MINIO_ACCESS_KEY=slotwise
MINIO_SECRET_KEY=slotwise-dev-minio-password

MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=slotwise

# Development sentinel. Rejected automatically when APP_ENV is staging or prod.
SECURITY_SECRET_KEY=dev-only-insecure-secret-key-change-me
# Access tokens. The signing key defaults to SECURITY_SECRET_KEY for local use;
# set SECURITY_JWT_SECRET_KEY to a dedicated 32+ character secret outside dev.
# SECURITY_JWT_SECRET_KEY=
SECURITY_JWT_ALGORITHM=HS256
SECURITY_JWT_KEY_ID=dev-1
# Rotation format: "old-kid:old-secret,older-kid:older-secret". Old keys stay
# accepted for verification until removed.
SECURITY_JWT_PREVIOUS_KEYS=
SECURITY_JWT_ISSUER=slotwise
SECURITY_JWT_AUDIENCE=slotwise-api
SECURITY_JWT_LEEWAY_SECONDS=30
SECURITY_ACCESS_TOKEN_EXPIRE_MINUTES=15
SECURITY_REFRESH_TOKEN_EXPIRE_HOURS=8
SECURITY_WS_TICKET_TTL_SECONDS=30

# Argon2id cost. Raise memory/time with hardware; never lower them in production.
SECURITY_PASSWORD_MIN_LENGTH=12
SECURITY_ARGON2_TIME_COST=3
SECURITY_ARGON2_MEMORY_COST=65536
SECURITY_ARGON2_PARALLELISM=4

# Durable lockout (PostgreSQL) and per-minute sliding windows (Redis).
SECURITY_LOCKOUT_THRESHOLD=5
SECURITY_LOCKOUT_MINUTES=15
SECURITY_RATE_LIMIT_LOGIN_PER_MINUTE=10
SECURITY_RATE_LIMIT_LOGIN_ACCOUNT_PER_MINUTE=5
SECURITY_RATE_LIMIT_REFRESH_PER_MINUTE=20
SECURITY_RATE_LIMIT_TICKET_PER_MINUTE=30
SECURITY_RATE_LIMIT_SENSOR_PER_MINUTE=60

# Refresh cookie. __Secure- is used instead of __Host- because the cookie is
# path-scoped to the auth routes and __Host- requires Path=/.
SECURITY_REFRESH_COOKIE_NAME=__Secure-slotwise_refresh
SECURITY_REFRESH_COOKIE_PATH=/api/v1/auth
SECURITY_REFRESH_COOKIE_SECURE=true
SECURITY_REFRESH_COOKIE_SAMESITE=strict
SECURITY_CSRF_HEADER_NAME=X-Requested-With
SECURITY_CSRF_HEADER_VALUE=slotwise-dashboard

MODULE_B_ENABLED=false
ALLOW_SELF_APPROVAL=false

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana
