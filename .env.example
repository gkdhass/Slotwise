# Slotwise environment variables (names only — never commit real values)
# Copy to .env for local dev.

# Database
DATABASE_URL=postgresql://slotwise:slotwise@localhost:5432/slotwise

# Auth / sessions
SESSION_SECRET=
CSRF_SECRET=
APP_BASE_URL=http://localhost:5173

# Email (Resend) — use Ethereal/Mailpit in dev
RESEND_API_KEY=
EMAIL_FROM=Slotwise <no-reply@example.test>
EMAIL_PROVIDER=resend

# Outbox worker
WORKER_SECRET=
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_BACKOFF_BASE_MS=1000

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Feature flags
ABUSE_DETECTION_ENABLED=false
PAYMENTS_ENABLED=false

# Monitoring (optional)
SENTRY_DSN=
LOG_LEVEL=info