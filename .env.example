# Slotwise environment variables (names only — never commit real values)
# Copy to .env for local dev.

# Database
# Use a DIRECT (non-pooled) connection string for migrations and the worker.
# Neon: prefer the "direct" connection string (not the pooled -pooler one).
DATABASE_URL=postgresql://slotwise:slotwise@localhost:5432/slotwise
# Optional pooled URL for serverless-ish read paths (not used in baseline):
# DATABASE_URL_POOLED=

# Auth / sessions
SESSION_SECRET=
CSRF_SECRET=
APP_BASE_URL=http://localhost:5173

# Reverse proxy (X-Forwarded-For)
# Number of reverse-proxy hops in front of the API. Leave unset/false for local
# dev, tests, or any host that exposes the port directly: X-Forwarded-For is
# then ignored and rate limits key on the socket address.
# Production REQUIREs an exact positive integer (startup fails otherwise).
# The API host per D-07 is Render or Railway; each adds exactly one hop
# (its edge proxy) -> TRUST_PROXY=1. Re-check if a CDN/WAF is added in front.
TRUST_PROXY=

# Email (Resend) — use Ethereal/Mailpit in dev
RESEND_API_KEY=
EMAIL_FROM=Slotwise <no-reply@example.test>
EMAIL_PROVIDER=resend

# Outbox worker
WORKER_SECRET=
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_BACKOFF_BASE_MS=1000

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Feature flags
ABUSE_DETECTION_ENABLED=false
PAYMENTS_ENABLED=false

# Monitoring (optional)
# JSON POST target for unhandled errors (any tracker or webhook that accepts JSON).
ERROR_MONITOR_WEBHOOK_URL=
LOG_LEVEL=info