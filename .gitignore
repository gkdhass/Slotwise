# Local-only artifacts and secrets. Never commit .env or generated keys.
.env
.env.*
!.env.example
*.pem
*.key
*.crt

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml

# Node / frontend
node_modules/
frontend/dist/
frontend/coverage/
*.tsbuildinfo

# Runtime data
backend/alembic/versions/*.pyc
infra/nginx/certs/
infra/grafana/data/
ml/data/*
!ml/data/.gitkeep
ml/export/*
!ml/export/.gitkeep

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
