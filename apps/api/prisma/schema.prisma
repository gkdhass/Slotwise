generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email          String    @unique
  passwordHash   String    @map("password_hash")
  role           String    @default("owner")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  sessions     Session[]
  eventTypes   EventType[]
  bookings     Booking[]

  @@map("users")
}

model Session {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model EventType {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  title            String
  slug             String    @unique
  description      String?
  durationMinutes  Int       @map("duration_minutes")
  locationType     String    @default("custom") @map("location_type")
  locationDetails  String?   @map("location_details")
  timezone         String
  isPublished      Boolean   @default(false) @map("is_published")
  archivedAt       DateTime? @map("archived_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  availability  AvailabilityRule[]
  bookings      Booking[]

  @@index([userId])
  @@index([userId, isPublished, archivedAt])
  @@map("event_types")
}

model AvailabilityRule {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventTypeId String   @map("event_type_id") @db.Uuid
  weekday     Int
  startLocal  String   @map("start_local") @db.VarChar(5)
  endLocal    String   @map("end_local") @db.VarChar(5)
  timezone    String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  eventType EventType @relation(fields: [eventTypeId], references: [id], onDelete: Cascade)

  @@index([eventTypeId])
  @@index([eventTypeId, weekday])
  @@map("availability_rules")
}

model Booking {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  eventTypeId    String    @map("event_type_id") @db.Uuid
  inviteeName    String    @map("invitee_name")
  inviteeEmail   String    @map("invitee_email")
  inviteeNote    String?   @map("invitee_note")
  startAt        DateTime  @map("start_at") @db.Timestamptz
  endAt          DateTime  @map("end_at") @db.Timestamptz
  timezone       String
  status         String    @default("confirmed")
  idempotencyKey String?   @map("idempotency_key")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user      User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  eventType EventType          @relation(fields: [eventTypeId], references: [id], onDelete: Restrict)
  tokens    ManagementToken[]
  outbox    OutboxJob[]

  @@unique([userId, idempotencyKey])
  @@index([userId])
  @@index([eventTypeId])
  @@index([startAt])
  @@index([status])
  @@index([userId, startAt(sort: Desc)])
  @@map("bookings")
}

model ManagementToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId String    @map("booking_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([expiresAt])
  @@map("management_tokens")
}

model OutboxJob {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId     String?   @map("booking_id") @db.Uuid
  jobType       String    @map("job_type")
  status        String    @default("pending")
  payload       Json      @default("{}")
  attempts      Int       @default(0)
  availableAt   DateTime  @default(now()) @map("available_at") @db.Timestamptz
  processedAt   DateTime? @map("processed_at") @db.Timestamptz
  lastErrorCode String?   @map("last_error_code")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([status, availableAt])
  @@index([bookingId])
  @@map("outbox_jobs")
}
