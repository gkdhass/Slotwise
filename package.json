{
  "name": "slotwise",
  "version": "0.0.0",
  "private": true,
  "description": "Slotwise — focused single-host scheduling MVP (final-year project).",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --parallel --filter @slotwise/web --filter @slotwise/api dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:unit": "pnpm --filter @slotwise/api test:unit && pnpm --filter @slotwise/web test:unit",
    "test:integration": "pnpm --filter @slotwise/api test:integration",
    "test:e2e": "pnpm --filter @slotwise/e2e test",
    "test:concurrency": "pnpm --filter @slotwise/api test:concurrency",
    "db:migrate": "pnpm --filter @slotwise/api prisma:migrate",
    "worker:email": "pnpm --filter @slotwise/api worker:email"
  },
  "devDependencies": {
    "prettier": "^3.3.0",
    "eslint": "^9.0.0",
    "typescript": "^5.6.0",
    "@playwright/test": "^1.49.0",
    "@axe-core/playwright": "^4.10.0"
  }
}
